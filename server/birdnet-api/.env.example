# Host/port the inference service binds to (internal network only, not published to the browser)
HOST=0.0.0.0
PORT=8000

# Enables uvicorn --reload
DEBUG=false

# Optional upload limit (bytes). Defaults to 104857600 (100MB) when unset
MAX_FILE_SIZE=104857600

# Default minimum confidence threshold when a request doesn't specify one
DEFAULT_MIN_CONFIDENCE=0.25

LOG_LEVEL=INFO
